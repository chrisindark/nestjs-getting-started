{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": ".",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.api.json"
  },
  "projects": {
    "api": {
      "type": "application",
      "root": ".",
      "sourceRoot": "src",
      "entryFile": "main",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.api.json"
      }
    },
    "cron": {
      "type": "application",
      "root": ".",
      "sourceRoot": "src",
      "entryFile": "cronmain",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.cron.json"
      }
    },
    "pubsub-consumer": {
      "type": "application",
      "root": ".",
      "sourceRoot": "src",
      "entryFile": "pubsubConsumerMain",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.pubsubConsumer.json"
      }
    },
    "kafka-consumer": {
      "type": "application",
      "root": ".",
      "sourceRoot": "src",
      "entryFile": "kafkaConsumerMain",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.kafkaConsumer.json"
      }
    },
    "queue-consumer": {
      "type": "application",
      "root": ".",
      "sourceRoot": "src",
      "entryFile": "queueConsumerMain",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.queueConsumer.json"
      }
    },
    "websocket": {
      "type": "application",
      "root": ".",
      "sourceRoot": "src",
      "entryFile": "websocketmain",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.websocket.json"
      }
    },
    "cli": {
      "type": "application",
      "root": ".",
      "sourceRoot": "src",
      "entryFile": "clmain",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.cli.json"
      }
    },
    "bootstrap": {
      "type": "library",
      "root": "libs/bootstrap",
      "sourceRoot": "libs/bootstrap/src",
      "entryFile": "index",
      "compilerOptions": {
        "tsConfigPath": "libs/bootstrap/tsconfig.lib.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "sourceRoot": "libs/config/src",
      "entryFile": "index",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "logger": {
      "type": "library",
      "root": "libs/logger",
      "sourceRoot": "libs/logger/src",
      "entryFile": "index",
      "compilerOptions": {
        "tsConfigPath": "libs/logger/tsconfig.lib.json"
      }
    },
    "queue": {
      "type": "library",
      "root": "libs/queue",
      "sourceRoot": "libs/queue/src",
      "entryFile": "index",
      "compilerOptions": {
        "tsConfigPath": "libs/queue/tsconfig.lib.json"
      }
    },
    "messaging": {
      "type": "library",
      "root": "libs/messaging",
      "sourceRoot": "libs/messaging/src",
      "entryFile": "index",
      "compilerOptions": {
        "tsConfigPath": "libs/messaging/tsconfig.lib.json"
      }
    },
    "publisher": {
      "type": "library",
      "root": "libs/publisher",
      "sourceRoot": "libs/publisher/src",
      "entryFile": "index",
      "compilerOptions": {
        "tsConfigPath": "libs/publisher/tsconfig.lib.json"
      }
    }
  }
}
